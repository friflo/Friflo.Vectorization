<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>TuiTerminal</RootNamespace>
        <Nullable>enable</Nullable>
        
        <IsAotCompatible>true</IsAotCompatible>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator> <!-- Required when using app.MapGet() with AOT -->
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Apps\Apps.csproj" />
      <ProjectReference Include="..\Friflo.SmGui.Assets\Friflo.SmGui.Assets.csproj" />
      <ProjectReference Include="..\Friflo.SmGui.Http\Friflo.SmGui.Http.csproj" />
      <ProjectReference Include="..\Friflo.SmGui.WebRTC\Friflo.SmGui.WebRTC.csproj" />
    </ItemGroup>

</Project>
