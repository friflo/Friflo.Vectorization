<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>Assets/friflo.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="SDL3-CS"           Version="3.4.10.3" />
      <PackageReference Include="SDL3-CS.Windows"   Version="3.4.10.3" />
      <PackageReference Include="SDL3-CS.MacOS"     Version="3.4.10.3" />
      <PackageReference Include="StbImageSharp"     Version="2.30.15" />
        
      <ProjectReference Include="..\..\src\Vectorization.Attributes\Friflo.Vectorization.Attributes.csproj" />
      <ProjectReference Include="..\..\src\Vectorization.WebGPU\Friflo.Vectorization.WebGPU.csproj" />
      <ProjectReference Include="..\..\src\Vectorization.Generators\Friflo.Vectorization.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Include="shaders\**\*.wgsl" />
      <AdditionalFiles  Include="shaders\**\*.wgsl" />
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Include="Assets/img/Di-3d.png" />      
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Include="Assets/wgpu-transparent-light-128x128.bmp" />
      <EmbeddedResource Include="Assets/wgpu-transparent-dark-128x128.bmp" />
    </ItemGroup>

</Project>
