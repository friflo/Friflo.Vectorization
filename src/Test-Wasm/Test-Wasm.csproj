<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
      
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Friflo.SmGui.Assets\Friflo.SmGui.Assets.csproj" />
    <ProjectReference Include="..\Friflo.SmGui.WebRTC\Friflo.SmGui.WebRTC.csproj" />
  </ItemGroup>
   
  <!-- Import is required when using Friflo.SmGui.WebRTC.csproj as ProjectReference -->
  <Import Project="..\Friflo.SmGui.WebRTC\build\Friflo.SmGui.WebRTC.targets" />
    
  <ItemGroup>
    <None Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
    
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <WasmEnableSIMD>true</WasmEnableSIMD>
      
    <!-- Additional High-Performance-Optimizations -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmStripNativeDebugSymbols>true</WasmStripNativeDebugSymbols>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityTracingSupport>false</HttpActivityTracingSupport>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

</Project>