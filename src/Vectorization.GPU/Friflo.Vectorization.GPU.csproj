<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>library</OutputType>
    <TargetFramework>net8</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Friflo.Vectorization.GPU</RootNamespace>
    <AssemblyName>Friflo.Vectorization.GPU</AssemblyName>
    <LangVersion>14.0</LangVersion>
    
    <!--
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    -->

    <!-- packaging -->
    <PackageVersion>0.0.0</PackageVersion>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>

    <Title>friflo vectorization attributes</Title>
    <Authors>Ullrich Praetz</Authors>
    <Description>attributes used to vectorize methods using Friflo.Vectorization.Generators</Description>
    <Copyright>Ullrich Praetz</Copyright>
    <PackageProjectUrl>https://github.com/friflo/Friflo.Vectorization</PackageProjectUrl>
    <RepositoryUrl>https://github.com/friflo/Friflo.Vectorization</RepositoryUrl>
    <PackageTags>vectorization, gpu, gpu-compute, csharp, dotnet, WebGPU, wpgu-native</PackageTags>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageIconUrl></PackageIconUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>
    <!-- packaging: end -->
  </PropertyGroup>

  <!-- packaging -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\package-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
  
    <ItemGroup>
        <PackageReference Include="Silk.NET.WebGPU" Version="2.23.0" />
        <PackageReference Include="Silk.NET.WebGPU.Extensions.WGPU" Version="2.23.0" />
        <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" Version="2.23.0" />
    </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <!-- packaging: end -->

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
